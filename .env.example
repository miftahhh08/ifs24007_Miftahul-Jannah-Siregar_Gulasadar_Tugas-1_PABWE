# Salin file ini menjadi .env (cp .env.example .env). SEMUA OPSIONAL.
# Tanpa API key, aplikasi tetap jalan penuh dalam "mode dasar"
# (pencarian database makanan + chatbot berbasis aturan).

# Mengaktifkan chatbot AI dan pengenalan makanan dari foto
ANTHROPIC_API_KEY=
# Model yang dipakai (opsional)
ANTHROPIC_MODEL=claude-sonnet-5-5

PORT=3000
